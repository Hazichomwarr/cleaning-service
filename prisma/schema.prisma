generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CleaningRequestStatus {
  NEW
  REVIEWING
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PropertyType {
  HOUSE
  APARTMENT
  OFFICE
  COMMERCIAL
  AIRBNB
  OTHER
}

enum WorkerType {
  CREW
  CONTRACTOR
}

enum CleaningEstimateOutcome {
  AUTOMATIC_ESTIMATE
  MANUAL_QUOTE_REQUIRED
  NO_CONFIGURED_ESTIMATE
  ESTIMATE_UNAVAILABLE
}

model CleaningService {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  requests CleaningRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requestStatusHistory CleaningRequestStatusHistory[]
}

model Customer {
  id       String  @id @default(cuid())
  name     String
  email    String?
  phone    String?
  isActive Boolean @default(true)

  properties CustomerProperty[]
  requests   CleaningRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([email])
  @@index([phone])
  @@index([isActive])
}

model CustomerProperty {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  label                 String?
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  postalCode            String
  propertyType          PropertyType
  bedrooms              Int?
  bathrooms             Decimal?     @db.Decimal(4, 1)
  approximateSquareFeet Int?
  isActive              Boolean      @default(true)

  requests CleaningRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([customerId, isActive])
}

model CleaningExtra {
  id           String  @id @default(cuid())
  name         String
  description  String?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  requestExtras CleaningRequestExtra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model Worker {
  id        String     @id @default(cuid())
  firstName String
  lastName  String
  phone     String?
  email     String?
  type      WorkerType
  isActive  Boolean    @default(true)

  assignments CleaningAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@index([lastName, firstName])
}

model PricingRule {
  id String @id @default(cuid())

  propertyType PropertyType?
  bedroomCount Int?

  startingPrice Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyType, bedroomCount, isActive])
}

model CleaningRequest {
  id            String @id @default(cuid())
  requestNumber String @unique

  serviceId String
  service   CleaningService @relation(fields: [serviceId], references: [id])

  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerPropertyId String?
  customerProperty   CustomerProperty? @relation(fields: [customerPropertyId], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String
  customerPhone String

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String

  propertyType PropertyType

  bedrooms              Int?
  bathrooms             Decimal? @db.Decimal(4, 1)
  approximateSquareFeet Int?

  preferredDate       DateTime
  preferredTimeWindow String

  estimatedPrice  Decimal?                @db.Decimal(10, 2)
  estimateOutcome CleaningEstimateOutcome
  confirmedPrice  Decimal?                @db.Decimal(10, 2)

  scheduledStart DateTime?
  scheduledEnd   DateTime?

  customerNotes String?
  internalNotes String?

  status CleaningRequestStatus @default(NEW)

  cancelledAt        DateTime?
  cancellationReason String?

  requestExtras CleaningRequestExtra[]
  assignments   CleaningAssignment[]
  statusHistory CleaningRequestStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([preferredDate])
  @@index([scheduledStart])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([serviceId])
  @@index([customerId])
  @@index([customerPropertyId])
}

model CleaningRequestStatusHistory {
  id String @id @default(cuid())

  cleaningRequestId String
  cleaningRequest   CleaningRequest @relation(fields: [cleaningRequestId], references: [id], onDelete: Cascade)

  fromStatus CleaningRequestStatus
  toStatus   CleaningRequestStatus

  changedByAdminUserId String
  changedByAdminUser   AdminUser @relation(fields: [changedByAdminUserId], references: [id], onDelete: Restrict)

  reason    String?
  createdAt DateTime @default(now())

  @@index([cleaningRequestId, createdAt])
  @@index([changedByAdminUserId, createdAt])
}

model CleaningRequestExtra {
  id String @id @default(cuid())

  cleaningRequestId String
  cleaningRequest   CleaningRequest @relation(fields: [cleaningRequestId], references: [id], onDelete: Cascade)

  cleaningExtraId String
  cleaningExtra   CleaningExtra @relation(fields: [cleaningExtraId], references: [id])

  createdAt DateTime @default(now())

  @@unique([cleaningRequestId, cleaningExtraId])
  @@index([cleaningExtraId])
}

model CleaningAssignment {
  id String @id @default(cuid())

  cleaningRequestId String
  cleaningRequest   CleaningRequest @relation(fields: [cleaningRequestId], references: [id], onDelete: Cascade)

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id])

  assignedAt DateTime @default(now())

  @@unique([cleaningRequestId, workerId])
  @@index([workerId, assignedAt])
  @@index([cleaningRequestId])
}
