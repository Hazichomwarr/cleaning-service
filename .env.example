DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
AUTH_SECRET="generate-a-long-random-production-secret"
CUSTOMER_VERIFICATION_SECRET="replace-with-a-long-random-server-secret"

# Optional: provisioning creates an admin only when all three are set.
ADMIN_NAME="Admin User"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-password"

# Transactional email (server-only)
RESEND_API_KEY="re_replace_me"
RESEND_FROM_EMAIL="notifications@example.com"
RESEND_FROM_NAME="Cleaning Service"

# Operational notifications
BUSINESS_NOTIFICATION_EMAIL="owner@example.com"
BUSINESS_NOTIFICATION_NAME="Cleaning Service"

# Hourly reminder route authentication (server-only; Vercel native cron uses this name)
CRON_SECRET="replace-with-a-long-random-secret"
